# ============================================
# AMBIENTE
# ============================================
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
METRICS_PORT=9100

# ============================================
# MYSQL (read-model do catálogo + pedidos)
# ============================================
# Local (sem Docker): localhost. No docker-compose o host vira "mysql".
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=casecellshop
MYSQL_PASSWORD=casecellshop
MYSQL_DATABASE=casecellshop

# ============================================
# REDIS (cache da vitrine)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================
# KAFKA (checkout assíncrono)
# ============================================
# Local (sem Docker) usa o listener externo do broker.
# No docker-compose o backend usa KAFKA_BROKERS=kafka:9092.
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=casecellshop-backend
KAFKA_CONSUMER_GROUP=checkout-worker

# ============================================
# REGRAS DE NEGÓCIO
# ============================================
# TTL do cache fresh e da cópia stale (fallback), em segundos.
PRODUCT_CACHE_TTL=30
PRODUCT_CACHE_STALE_TTL=300
# Tentativas do worker antes de marcar o pedido como failed (e reconciliar estoque).
CHECKOUT_MAX_ATTEMPTS=3
# Taxa de falha simulada do ERP (0 = sempre sucesso; 0.5 = exercita retry).
ERP_FAILURE_RATE=0

# ============================================
# GRAFANA
# ============================================
GRAFANA_PORT=3100
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
